// Prisma Schema for VeterinarIA_Next - Multi-Tenant Veterinary Hospital SaaS
// El Salvador DTE, ICU, Surgery, Lab, PACS DICOM, Triage, Consultorios, Inventario PEPS

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum BranchFacilityType {
  MAIN_HOSPITAL_24_7
  AMBULATORY_CLINIC
  EMERGENCY_POST
  DIAGNOSTIC_CENTER
}

enum ClientTaxType {
  CONSUMIDOR_FINAL
  CONTRIBUYENTE_CREDITO_FISCAL
  EXTRANJERO
}

enum ClientCategoryTag {
  STANDARD
  VIP
  FREQUENT
  RESCUER_SHELTER
  DEBTOR
  HIGH_RISK_CAUTION
}

enum AnimalGender {
  MALE_INTACT
  MALE_NEUTERED
  FEMALE_INTACT
  FEMALE_SPAYED
  UNKNOWN
}

enum TemperamentAlertType {
  FRIENDLY
  FEARFUL_AGGRESSIVE
  REQUIRES_MUZZLE
  FRACTIOUS_CAT
  HIGH_STRESS_CARDIOPATH
  NO_DOGS_COMPATIBLE
}

enum VaccineStatus {
  APPLIED
  DUE_SOON
  EXPIRED
}

enum RoomType {
  CONSULTATION_GENERAL
  CONSULTATION_SPECIALTY
  SURGERY_ROOM
  ICU_ROOM
  XRAY_ROOM
  TRIAGE_ROOM
  GROOMING_ROOM
}

enum RoomOperationalStatus {
  AVAILABLE
  OCCUPIED
  CLEANING_STERILIZING
  MAINTENANCE
}

enum EmergencyTriageColor {
  RED_IMMEDIATE
  ORANGE_VERY_URGENT
  YELLOW_URGENT
  GREEN_STANDARD
  BLUE_NON_URGENT
}

enum EmergencyClinicalStatus {
  TRIAGED
  IN_CRASH_ROOM
  STABILIZING
  RECOVERED_TO_CONSULT
  TRANSFERRED_TO_ICU
  TRANSFERRED_TO_OR
  DECEASED
  DISCHARGED
}

enum ConsultationType {
  GENERAL
  FOLLOW_UP
  EMERGENCY_TRIAGE
  VACCINATION_CHECK
  SPECIALTY
  TELEMEDICINE
}

enum ConsentFormType {
  SURGERY_ANESTHESIA
  HOSPITALIZATION_ADMISSION
  HIGH_RISK_PROCEDURE
  EUTHANASIA_COMPASSIONATE
}

enum SurgeryStatus {
  SCHEDULED
  PRE_OP
  IN_SURGERY
  RECOVERY
  COMPLETED
  CANCELLED
}

enum AsaRiskClassification {
  ASA_I
  ASA_II
  ASA_III
  ASA_IV
  ASA_V
  ASA_E
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_WAITING_ROOM
  IN_CONSULTATION
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum MhEnvironmentType {
  SANDBOX   @map("00")
  PRODUCTION @map("01")
}

enum DteDocumentType {
  FACTURA                @map("01")
  COMPROBANTE_CRED_FISC  @map("03")
  NOTA_CREDITO           @map("05")
  NOTA_DEBITO            @map("06")
  SUJETO_EXCLUIDO        @map("14")
}

enum DteTransmissionStatus {
  DRAFT
  SIGNED
  TRANSMITTED
  RECEIVED
  REJECTED
  CONTINGENCY
}

// ============================================================================
// 1. TENANTS Y SUCURSALES
// ============================================================================

model Tenant {
  id                   String   @id @default(uuid()) @db.Uuid
  legalName            String   @map("legal_name") @db.VarChar(150)
  tradeName            String   @map("trade_name") @db.VarChar(150)
  nit                  String   @db.VarChar(17)
  nrc                  String   @db.VarChar(20)
  economicActivityCode String   @map("economic_activity_code") @db.VarChar(10)
  economicActivityName String   @map("economic_activity_name") @db.VarChar(200)
  countryCode          String   @default("SV") @map("country_code") @db.Char(2)
  currencyCode         String   @default("USD") @map("currency_code") @db.Char(3)
  subdomain            String   @unique @db.VarChar(63)
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  branches             Branch[]
  posTerminals         PosTerminal[]
  roles                Role[]
  userTenants          UserTenant[]
  userBranchAssignments UserBranchAssignment[]
  doctorProfiles       DoctorProfile[]
  doctorSchedules      DoctorSchedule[]
  clients              Client[]
  clientPortalAccesses ClientPortalAccess[]
  breeds               Breed[]
  patients             Patient[]
  patientCoOwners      PatientCoOwner[]
  weightHistories      PatientWeightHistory[]
  vaccinations         VaccinationRecord[]
  dewormings           DewormingRecord[]
  antiparasitics       AntiparasiticRecord[]
  rooms                Room[]
  roomReservations     RoomReservation[]
  emergencyTriages     EmergencyTriage[]
  consultations        Consultation[]
  consultationAddendums ConsultationAddendum[]
  prescriptions        Prescription[]
  prescriptionItems    PrescriptionItem[]
  consentForms         DigitalConsentForm[]
  surgeries            Surgery[]
  surgeryAnesthesiaLogs SurgeryAnesthesiaLog[]
  labOrders            LabOrder[]
  labTestResults       LabTestResult[]
  imagingStudies       ImagingStudy[]
  hospitalizations     Hospitalization[]
  hospitalizationOrders HospitalizationOrder[]
  flowboardExecutions  FlowboardExecution[]
  groomingSessions     GroomingSession[]
  suppliers            Supplier[]
  inventoryCategories  InventoryCategory[]
  inventoryItems       InventoryItem[]
  inventoryStocks      InventoryStock[]
  inventoryLots        InventoryLot[]
  openVials            PharmacyOpenVial[]
  purchaseOrders       PurchaseOrder[]
  purchaseOrderItems   PurchaseOrderItem[]
  inventoryAdjustments InventoryAdjustment[]
  inventoryTransfers   InventoryTransfer[]
  inventoryTransferItems InventoryTransferItem[]
  dteConfig            TenantDteConfig?
  dteInvoices          DteInvoice[]
  dteInvoiceItems      DteInvoiceItem[]
  doctorScheduleOverrides DoctorScheduleOverride[]
  appointments         Appointment[]

  @@map("tenants")
}

model Branch {
  id                        String             @id @default(uuid()) @db.Uuid
  tenantId                  String             @map("tenant_id") @db.Uuid
  parentBranchId            String?            @map("parent_branch_id") @db.Uuid
  name                      String             @db.VarChar(100)
  code                      String             @db.VarChar(10)
  facilityType              BranchFacilityType @default(MAIN_HOSPITAL_24_7) @map("facility_type")
  address                   String             @db.Text
  departmentCode            String             @default("06") @map("department_code") @db.Char(2)
  municipalityCode          String             @default("14") @map("municipality_code") @db.Char(2)
  establishmentCodeMh       String             @default("M001") @map("establishment_code_mh") @db.VarChar(4)
  phoneE164                 String             @map("phone_e164") @db.VarChar(20)
  emailContact              String             @map("email_contact") @db.VarChar(255)
  timezone                  String             @default("America/El_Salvador") @db.VarChar(50)
  hospitalizationCapacity   Int                @default(0) @map("hospitalization_capacity")
  icuCapacity               Int                @default(0) @map("icu_capacity")
  hasSurgeryRoom            Boolean            @default(true) @map("has_surgery_room")
  hasGroomingSalon          Boolean            @default(true) @map("has_grooming_salon")
  hasXrayImaging            Boolean            @default(true) @map("has_xray_imaging")
  hasLabFacility            Boolean            @default(true) @map("has_lab_facility")
  hasEmergencyService247    Boolean            @default(true) @map("has_emergency_service_24_7")
  isActive                  Boolean            @default(true) @map("is_active")
  createdAt                 DateTime           @default(now()) @map("created_at") @db.Timestamptz

  tenant                    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parentBranch              Branch?            @relation("BranchHierarchy", fields: [parentBranchId], references: [id], onDelete: SetNull)
  childBranches             Branch[]           @relation("BranchHierarchy")
  posTerminals              PosTerminal[]
  userBranchAssignments     UserBranchAssignment[]
  doctorSchedules           DoctorSchedule[]
  doctorScheduleOverrides   DoctorScheduleOverride[]
  appointments              Appointment[]
  weightHistories           PatientWeightHistory[]
  vaccinations              VaccinationRecord[]
  dewormings                DewormingRecord[]
  antiparasitics            AntiparasiticRecord[]
  rooms                     Room[]
  roomReservations          RoomReservation[]
  emergencyTriages          EmergencyTriage[]
  consultations             Consultation[]
  prescriptions             Prescription[]
  consentForms              DigitalConsentForm[]
  surgeries                 Surgery[]
  labOrders                 LabOrder[]
  imagingStudies            ImagingStudy[]
  hospitalizations          Hospitalization[]
  groomingSessions          GroomingSession[]
  inventoryStocks           InventoryStock[]
  inventoryLots             InventoryLot[]
  openVials                 PharmacyOpenVial[]
  purchaseOrders            PurchaseOrder[]
  inventoryAdjustments      InventoryAdjustment[]
  sourceTransfers           InventoryTransfer[] @relation("SourceBranch")
  targetTransfers           InventoryTransfer[] @relation("TargetBranch")
  dteInvoices               DteInvoice[]

  @@unique([tenantId, code])
  @@unique([tenantId, establishmentCodeMh])
  @@index([tenantId], name: "idx_branches_tenant")
  @@map("branches")
}

model PosTerminal {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @map("tenant_id") @db.Uuid
  branchId     String       @map("branch_id") @db.Uuid
  terminalCode String       @default("P001") @map("terminal_code") @db.VarChar(4)
  name         String       @db.VarChar(50)
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  dteInvoices  DteInvoice[]

  @@unique([branchId, terminalCode])
  @@index([tenantId, branchId], name: "idx_pos_terminals_branch")
  @@map("pos_terminals")
}

// ============================================================================
// 2. USUARIOS Y CONTROL DE ACCESO (RBAC)
// ============================================================================

model User {
  id                  String       @id @default(uuid()) @db.Uuid
  email               String       @unique @db.VarChar(255)
  passwordHash        String       @map("password_hash") @db.VarChar(255)
  fullName            String       @map("full_name") @db.VarChar(150)
  phoneE164           String?      @map("phone_e164") @db.VarChar(20)
  professionalLicense String?      @map("professional_license") @db.VarChar(50)
  isSuperAdmin        Boolean      @default(false) @map("is_super_admin")
  isActive            Boolean      @default(true) @map("is_active")
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  userTenants         UserTenant[]
  branchAssignments   UserBranchAssignment[]
  doctorProfile       DoctorProfile?
  weightHistories     PatientWeightHistory[]
  vaccinationsGiven   VaccinationRecord[]
  dewormingsGiven     DewormingRecord[]
  antiparasiticsGiven AntiparasiticRecord[]
  roomsOccupied       Room[]
  roomReservations    RoomReservation[]
  triagesEvaluated    EmergencyTriage[]      @relation("TriageEvaluator")
  triagesAttended     EmergencyTriage[]      @relation("TriageAttendingVet")
  consultations       Consultation[]         @relation("VetConsultations")
  consultationAddendums ConsultationAddendum[]
  prescriptionsWritten Prescription[]
  leadSurgeries       Surgery[]              @relation("LeadSurgeon")
  assistedSurgeries   Surgery[]              @relation("Anesthesiologist")
  labOrdersRequested  LabOrder[]             @relation("LabRequestedBy")
  imagingPrescribed   ImagingStudy[]         @relation("ImagingPrescribedBy")
  hospitalizationsAttended Hospitalization[]
  administeredFlowboard FlowboardExecution[]
  groomingSessionsAttended GroomingSession[]
  openVialsCreated    PharmacyOpenVial[]
  purchaseOrdersCreated PurchaseOrder[]      @relation("PoOrderedBy")
  purchaseOrdersReceived PurchaseOrder[]     @relation("PoReceivedBy")
  inventoryAdjustments InventoryAdjustment[]
  transfersRequested  InventoryTransfer[]    @relation("TransferRequestedBy")
  transfersSent       InventoryTransfer[]    @relation("TransferSentBy")
  transfersReceived   InventoryTransfer[]    @relation("TransferReceivedBy")
  appointmentsCreated Appointment[]          @relation("AppointmentCreatedBy")
  appointmentsOverbookingAuth Appointment[]  @relation("AppointmentOverbookingAuth")

  @@map("users")
}

model Role {
  id                   String             @id @default(uuid()) @db.Uuid
  tenantId             String?            @map("tenant_id") @db.Uuid
  name                 String             @db.VarChar(50)
  isSystemRole         Boolean            @default(false) @map("is_system_role")
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz

  tenant               Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions      RolePermission[]
  userTenants          UserTenant[]
  userBranchAssignments UserBranchAssignment[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  code            String           @unique @db.VarChar(100)
  module          String           @db.VarChar(50)
  description     String           @db.Text

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserTenant {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, tenantId])
  @@index([tenantId, userId], name: "idx_user_tenants_lookup")
  @@map("user_tenants")
}

model UserBranchAssignment {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  branchId          String   @map("branch_id") @db.Uuid
  roleId            String?  @map("role_id") @db.Uuid
  isDefaultBranch   Boolean  @default(false) @map("is_default_branch")
  canSwitchBranches Boolean  @default(true) @map("can_switch_branches")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch            Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  role              Role?    @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@unique([userId, branchId])
  @@index([tenantId, userId, branchId], name: "idx_user_branch_assignments")
  @@map("user_branch_assignments")
}

model DoctorProfile {
  id                              String           @id @default(uuid()) @db.Uuid
  tenantId                        String           @map("tenant_id") @db.Uuid
  userId                          String           @unique @map("user_id") @db.Uuid
  jvpmLicenseNumber               String           @map("jvpm_license_number") @db.VarChar(30)
  specialties                     String[]         @default([])
  signatureImageUrl               String?          @map("signature_image_url") @db.Text
  stampImageUrl                   String?          @map("stamp_image_url") @db.Text
  isLeadSurgeon                   Boolean          @default(false) @map("is_lead_surgeon")
  isAnesthesiologist              Boolean          @default(false) @map("is_anesthesiologist")
  isIntensivistIcu                Boolean          @default(false) @map("is_intensivist_icu")
  emergencyBreakGlassAuthorized   Boolean          @default(true) @map("emergency_break_glass_authorized")
  createdAt                       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant                          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedules                       DoctorSchedule[]
  scheduleOverrides               DoctorScheduleOverride[]
  appointments                    Appointment[]

  @@index([tenantId, userId], name: "idx_doctor_profiles_tenant")
  @@map("doctor_profiles")
}

model DoctorSchedule {
  id                     String        @id @default(uuid()) @db.Uuid
  tenantId               String        @map("tenant_id") @db.Uuid
  doctorId               String        @map("doctor_id") @db.Uuid
  branchId               String        @map("branch_id") @db.Uuid
  dayOfWeek              Int           @map("day_of_week") @db.SmallInt // 0=Sun, 6=Sat
  startTime              String        @map("start_time") @db.VarChar(10) // HH:mm
  endTime                String        @map("end_time") @db.VarChar(10)   // HH:mm
  breakStartTime         String?       @map("break_start_time") @db.VarChar(10) // HH:mm
  breakEndTime           String?       @map("break_end_time") @db.VarChar(10)   // HH:mm
  slotDurationMinutes    Int           @default(30) @map("slot_duration_minutes")
  dailyConsultationLimit Int           @default(12) @map("daily_consultation_limit")
  isNightShift           Boolean       @default(false) @map("is_night_shift")
  isActive               Boolean       @default(true) @map("is_active")
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz

  tenant                 Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  doctor                 DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  branch                 Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([tenantId, branchId, dayOfWeek], name: "idx_doctor_schedules_branch")
  @@map("doctor_schedules")
}

model DoctorScheduleOverride {
  id                 String        @id @default(uuid()) @db.Uuid
  tenantId           String        @map("tenant_id") @db.Uuid
  doctorId           String        @map("doctor_id") @db.Uuid
  branchId           String?       @map("branch_id") @db.Uuid
  overrideDate       DateTime      @map("override_date") @db.Date
  startTime          String?       @map("start_time") @db.VarChar(10)
  endTime            String?       @map("end_time") @db.VarChar(10)
  reason             String        @db.VarChar(150)
  isFullDayBlocked   Boolean       @default(true) @map("is_full_day_blocked")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz

  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  doctor             DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  branch             Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([tenantId, doctorId, overrideDate], name: "idx_schedule_overrides_lookup")
  @@map("doctor_schedule_overrides")
}

model Appointment {
  id                             String            @id @default(uuid()) @db.Uuid
  tenantId                       String            @map("tenant_id") @db.Uuid
  branchId                       String            @map("branch_id") @db.Uuid
  doctorId                       String            @map("doctor_id") @db.Uuid
  patientId                      String            @map("patient_id") @db.Uuid
  clientId                       String            @map("client_id") @db.Uuid
  roomId                         String?           @map("room_id") @db.Uuid
  appointmentDate                DateTime          @map("appointment_date") @db.Date
  startTime                      String            @map("start_time") @db.VarChar(10)
  endTime                        String            @map("end_time") @db.VarChar(10)
  status                         AppointmentStatus @default(SCHEDULED)
  serviceType                    String            @default("CONSULTA_GENERAL") @map("service_type") @db.VarChar(60)
  reasonForVisit                 String?           @map("reason_for_visit") @db.Text
  internalNotes                  String?           @map("internal_notes") @db.Text
  isOverbooking                  Boolean           @default(false) @map("is_overbooking")
  overbookingAuthorizedByUserId  String?           @map("overbooking_authorized_by_user_id") @db.Uuid
  createdByUserId                String?           @map("created_by_user_id") @db.Uuid
  createdAt                      DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                      DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant                         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch                         Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  doctor                         DoctorProfile     @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  patient                        Patient           @relation(fields: [patientId], references: [id], onDelete: Restrict)
  client                         Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  room                           Room?             @relation(fields: [roomId], references: [id], onDelete: SetNull)
  createdByUser                  User?             @relation("AppointmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  overbookingAuthorizedByUser    User?             @relation("AppointmentOverbookingAuth", fields: [overbookingAuthorizedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, branchId, appointmentDate], name: "idx_appointments_branch_date")
  @@index([tenantId, doctorId, appointmentDate], name: "idx_appointments_doctor_date")
  @@map("appointments")
}

// ============================================================================
// 3. CLIENTES (TUTORES) Y PACIENTES (MASCOTAS)
// ============================================================================

model Client {
  id                            String             @id @default(uuid()) @db.Uuid
  tenantId                      String             @map("tenant_id") @db.Uuid
  firstName                     String             @map("first_name") @db.VarChar(100)
  lastName                      String             @map("last_name") @db.VarChar(100)
  taxType                       ClientTaxType      @default(CONSUMIDOR_FINAL) @map("tax_type")
  category                      ClientCategoryTag  @default(STANDARD)
  dui                           String?            @db.VarChar(10)
  nit                           String?            @db.VarChar(17)
  nrc                           String?            @db.VarChar(20)
  economicActivityCode          String?            @map("economic_activity_code") @db.VarChar(10)
  tradeName                     String?            @map("trade_name") @db.VarChar(150)
  phoneE164                     String             @map("phone_e164") @db.VarChar(20)
  secondaryPhone                String?            @map("secondary_phone") @db.VarChar(20)
  email                         String             @db.VarChar(255)
  address                       String             @db.Text
  departmentCode                String             @default("06") @map("department_code") @db.Char(2)
  municipalityCode              String             @default("14") @map("municipality_code") @db.Char(2)
  emergencyContactName          String?            @map("emergency_contact_name") @db.VarChar(100)
  emergencyContactPhone         String?            @map("emergency_contact_phone") @db.VarChar(20)
  emergencyContactRelationship  String?            @map("emergency_contact_relationship") @db.VarChar(50)
  currentBalance                Decimal            @default(0.00) @map("current_balance") @db.Decimal(10, 2)
  creditLimit                   Decimal            @default(0.00) @map("credit_limit") @db.Decimal(10, 2)
  internalNotes                 String?            @map("internal_notes") @db.Text
  isActive                      Boolean            @default(true) @map("is_active")
  createdAt                     DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                     DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant                        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  portalAccess                  ClientPortalAccess?
  patients                      Patient[]
  coOwnedPatients               PatientCoOwner[]
  emergencyTriages              EmergencyTriage[]
  consentForms                  DigitalConsentForm[]
  groomingSessions              GroomingSession[]
  dteInvoices                   DteInvoice[]
  appointments                  Appointment[]

  @@index([tenantId, phoneE164], name: "idx_clients_phone")
  @@index([tenantId, lastName, firstName], name: "idx_clients_name")
  @@index([tenantId, dui], name: "idx_clients_dui")
  @@map("clients")
}

model ClientPortalAccess {
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  clientId            String    @unique @map("client_id") @db.Uuid
