  emergencyTriages    EmergencyTriage[]
  consultations       Consultation[]
  surgeries           Surgery[]
  groomingSessions    GroomingSession[]
  appointments        Appointment[]

  @@unique([branchId, code])
  @@index([tenantId, branchId, status], name: "idx_rooms_branch_status")
  @@map("rooms")
}

model RoomReservation {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  branchId        String   @map("branch_id") @db.Uuid
  roomId          String   @map("room_id") @db.Uuid
  reservedByUserId String  @map("reserved_by_user_id") @db.Uuid
  patientId       String?  @map("patient_id") @db.Uuid
  purpose         String   @db.VarChar(150)
  startTime       DateTime @map("start_time") @db.Timestamptz
  endTime         DateTime @map("end_time") @db.Timestamptz
