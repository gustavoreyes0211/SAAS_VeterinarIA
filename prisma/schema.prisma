  orderedByUserId       String              @map("ordered_by_user_id") @db.Uuid
  receivedByUserId      String?             @map("received_by_user_id") @db.Uuid
  receivedAt            DateTime?           @map("received_at") @db.Timestamptz
  notes                 String?             @db.Text
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz

  tenant                Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch                Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  supplier              Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  orderedBy             User                @relation("PoOrderedBy", fields: [orderedByUserId], references: [id], onDelete: Restrict)
  receivedBy            User?               @relation("PoReceivedBy", fields: [receivedByUserId], references: [id], onDelete: SetNull)
  items                 PurchaseOrderItem[]

  @@unique([tenantId, poNumber])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  purchaseOrderId String        @map("purchase_order_id") @db.Uuid
  itemId          String        @map("item_id") @db.Uuid
  quantityOrdered Decimal       @map("quantity_ordered") @db.Decimal(12, 3)
  quantityReceived Decimal      @default(0.000) @map("quantity_received") @db.Decimal(12, 3)
  unitCost        Decimal       @map("unit_cost") @db.Decimal(12, 4)
  lotNumber       String?       @map("lot_number") @db.VarChar(50)
  expirationDate  DateTime?     @map("expiration_date") @db.Date
  subtotal        Decimal       @db.Decimal(12, 2)

  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  item            InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@map("purchase_order_items")
}

model InventoryAdjustment {
  id                 String         @id @default(uuid()) @db.Uuid
  tenantId           String         @map("tenant_id") @db.Uuid
  branchId           String         @map("branch_id") @db.Uuid
  itemId             String         @map("item_id") @db.Uuid
  lotId              String?        @map("lot_id") @db.Uuid
  adjustmentType     String         @map("adjustment_type") @db.VarChar(30)
  quantityAdjusted   Decimal        @map("quantity_adjusted") @db.Decimal(12, 3)
  justification      String         @db.Text
  authorizedByUserId String         @map("authorized_by_user_id") @db.Uuid
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz

  tenant             Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch             Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  item               InventoryItem  @relation(fields: [itemId], references: [id], onDelete: Restrict)
  lot                InventoryLot?  @relation(fields: [lotId], references: [id], onDelete: SetNull)
  authorizedBy       User           @relation(fields: [authorizedByUserId], references: [id], onDelete: Restrict)

  @@map("inventory_adjustments")
}

model InventoryTransfer {
  id                 String                  @id @default(uuid()) @db.Uuid
  tenantId           String                  @map("tenant_id") @db.Uuid
  sourceBranchId     String                  @map("source_branch_id") @db.Uuid
  targetBranchId     String                  @map("target_branch_id") @db.Uuid
  transferCode       String                  @map("transfer_code") @db.VarChar(30)
  status             String                  @default("REQUESTED") @db.VarChar(20)
  requestedByUserId  String                  @map("requested_by_user_id") @db.Uuid
  sentByUserId       String?                 @map("sent_by_user_id") @db.Uuid
  receivedByUserId   String?                 @map("received_by_user_id") @db.Uuid
  notes              String?                 @db.Text
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz

  tenant             Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceBranch       Branch                  @relation("SourceBranch", fields: [sourceBranchId], references: [id], onDelete: Restrict)
  targetBranch       Branch                  @relation("TargetBranch", fields: [targetBranchId], references: [id], onDelete: Restrict)
  requestedBy        User                    @relation("TransferRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  sentBy             User?                   @relation("TransferSentBy", fields: [sentByUserId], references: [id], onDelete: SetNull)
  receivedBy         User?                   @relation("TransferReceivedBy", fields: [receivedByUserId], references: [id], onDelete: SetNull)
  items              InventoryTransferItem[]

  @@unique([tenantId, transferCode])
  @@map("inventory_transfers")
}

model InventoryTransferItem {
  id               String             @id @default(uuid()) @db.Uuid
  tenantId         String             @map("tenant_id") @db.Uuid
  transferId       String             @map("transfer_id") @db.Uuid
  itemId           String             @map("item_id") @db.Uuid
  lotId            String?            @map("lot_id") @db.Uuid
  quantitySent     Decimal            @map("quantity_sent") @db.Decimal(12, 3)
  quantityReceived Decimal            @default(0.000) @map("quantity_received") @db.Decimal(12, 3)

  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transfer         InventoryTransfer  @relation(fields: [transferId], references: [id], onDelete: Cascade)
  item             InventoryItem      @relation(fields: [itemId], references: [id], onDelete: Restrict)
  lot              InventoryLot?      @relation(fields: [lotId], references: [id], onDelete: SetNull)

  @@map("inventory_transfer_items")
}

// ============================================================================
// 10. FACTURACIÓN ELECTRÓNICA DTE (EL SALVADOR)
// ============================================================================

model TenantDteConfig {
  id                      String            @id @default(uuid()) @db.Uuid
  tenantId                String            @unique @map("tenant_id") @db.Uuid
  environment             MhEnvironmentType @default(SANDBOX)
  authUser                String            @map("auth_user") @db.VarChar(100)
  apiAuthToken            String?           @map("api_auth_token") @db.Text
  apiAuthTokenExpiresAt   DateTime?         @map("api_auth_token_expires_at") @db.Timestamptz
  privateKeyEncrypted     String            @map("private_key_encrypted") @db.Text
  certificatePasswordHash String            @map("certificate_password_hash") @db.VarChar(255)
  createdAt               DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant                  Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_dte_configs")
}

model DteInvoice {
  id                 String                @id @default(uuid()) @db.Uuid
  tenantId           String                @map("tenant_id") @db.Uuid
  branchId           String                @map("branch_id") @db.Uuid
  posTerminalId      String                @map("pos_terminal_id") @db.Uuid
  clientId           String                @map("client_id") @db.Uuid
  patientId          String?               @map("patient_id") @db.Uuid

  emergencyTriageId  String?               @map("emergency_triage_id") @db.Uuid
  consultationId     String?               @map("consultation_id") @db.Uuid
  surgeryId          String?               @map("surgery_id") @db.Uuid
  hospitalizationId  String?               @map("hospitalization_id") @db.Uuid
  groomingSessionId  String?               @map("grooming_session_id") @db.Uuid
  labOrderId         String?               @map("lab_order_id") @db.Uuid
  imagingStudyId     String?               @map("imaging_study_id") @db.Uuid

  dteType            DteDocumentType       @default(FACTURA) @map("dte_type")
  generationCode     String                @default(uuid()) @map("generation_code") @db.Uuid
  controlNumber      String                @map("control_number") @db.VarChar(31)
  sequentialNumber   BigInt                @map("sequential_number")
  transmissionStatus DteTransmissionStatus @default(DRAFT) @map("transmission_status")
  receptionStamp     String?               @map("reception_stamp") @db.VarChar(50)
  mhReceivedAt       DateTime?             @map("mh_received_at") @db.Timestamptz

  totalExempt        Decimal               @default(0.00) @map("total_exempt") @db.Decimal(12, 2)
  totalGravado       Decimal               @default(0.00) @map("total_gravado") @db.Decimal(12, 2)
  subtotal           Decimal               @db.Decimal(12, 2)
  ivaAmount          Decimal               @default(0.00) @map("iva_amount") @db.Decimal(12, 2)
  ivaRetention       Decimal               @default(0.00) @map("iva_retention") @db.Decimal(12, 2)
  totalPayable       Decimal               @map("total_payable") @db.Decimal(12, 2)

  paymentMethodCode  String                @default("01") @map("payment_method_code") @db.VarChar(2)
  signedJwsPayload   String?               @map("signed_jws_payload") @db.Text
  qrUrl              String?               @map("qr_url") @db.Text
  pdfUrl             String?               @map("pdf_url") @db.Text
  issuedAt           DateTime              @default(now()) @map("issued_at") @db.Timestamptz
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz

  tenant             Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch             Branch                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  posTerminal        PosTerminal           @relation(fields: [posTerminalId], references: [id], onDelete: Restrict)
  client             Client                @relation(fields: [clientId], references: [id], onDelete: Restrict)
  patient            Patient?              @relation(fields: [patientId], references: [id], onDelete: SetNull)

  emergencyTriage    EmergencyTriage?      @relation(fields: [emergencyTriageId], references: [id], onDelete: SetNull)
  consultation       Consultation?         @relation(fields: [consultationId], references: [id], onDelete: SetNull)
  surgery            Surgery?              @relation(fields: [surgeryId], references: [id], onDelete: SetNull)
  hospitalization    Hospitalization?      @relation(fields: [hospitalizationId], references: [id], onDelete: SetNull)
  groomingSession    GroomingSession?      @relation(fields: [groomingSessionId], references: [id], onDelete: SetNull)
  labOrder           LabOrder?             @relation(fields: [labOrderId], references: [id], onDelete: SetNull)
  imagingStudy       ImagingStudy?         @relation(fields: [imagingStudyId], references: [id], onDelete: SetNull)

  items              DteInvoiceItem[]

  @@unique([tenantId, dteType, controlNumber])
  @@map("dte_invoices")
}

model DteInvoiceItem {
  id          String         @id @default(uuid()) @db.Uuid
  tenantId    String         @map("tenant_id") @db.Uuid
  invoiceId   String         @map("invoice_id") @db.Uuid
  itemId      String?        @map("item_id") @db.Uuid
  lotId       String?        @map("lot_id") @db.Uuid
  itemNumber  Int            @map("item_number")
  itemType    String         @map("item_type") @db.VarChar(20)
  description String         @db.VarChar(250)
  quantity    Decimal        @db.Decimal(10, 3)
  unitPrice   Decimal        @map("unit_price") @db.Decimal(12, 4)
  lineTotal   Decimal        @map("line_total") @db.Decimal(12, 2)

  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice     DteInvoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  item        InventoryItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  lot         InventoryLot?  @relation(fields: [lotId], references: [id], onDelete: SetNull)

  @@unique([invoiceId, itemNumber])
  @@map("dte_invoice_items")
}
