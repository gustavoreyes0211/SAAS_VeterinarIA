model EmergencyTriage {
  id                     String                  @id @default(uuid()) @db.Uuid
  tenantId               String                  @map("tenant_id") @db.Uuid
  branchId               String                  @map("branch_id") @db.Uuid
  patientId              String?                 @map("patient_id") @db.Uuid
  clientId               String?                 @map("client_id") @db.Uuid
  evaluatedByUserId      String                  @map("evaluated_by_user_id") @db.Uuid
  attendingVetId         String?                 @map("attending_vet_id") @db.Uuid
  triageColor            EmergencyTriageColor    @default(YELLOW_URGENT) @map("triage_color")
  clinicalStatus         EmergencyClinicalStatus @default(TRIAGED) @map("clinical_status")
  chiefComplaint         String                  @map("chief_complaint") @db.Text
  estimatedOrFastWeightKg Decimal                @map("estimated_or_fast_weight_kg") @db.Decimal(6, 3)
  airwayStatus           String                  @default("PATENT") @map("airway_status") @db.VarChar(30)
  breathingEffort        String                  @default("NORMAL") @map("breathing_effort") @db.VarChar(30)
  circulationPulse       String                  @default("STRONG") @map("circulation_pulse") @db.VarChar(30)
  capillaryRefillSeconds Decimal?                @map("capillary_refill_seconds") @db.Decimal(3, 1)
  mucousColor            String                  @default("PINK") @map("mucous_color") @db.VarChar(30)
  mentalStatus           String                  @default("ALERT") @map("mental_status") @db.VarChar(30)
  tempCelsius            Decimal?                @map("temp_celsius") @db.Decimal(4, 2)
  heartRateBpm           Int?                    @map("heart_rate_bpm")
  respiratoryRateBpm     Int?                    @map("respiratory_rate_bpm")
  spo2Percent            Decimal?                @map("spo2_percent") @db.Decimal(4, 1)
  systolicBp             Int?                    @map("systolic_bp")
  glucoseMgDl            Int?                    @map("glucose_mg_dl")
  lactateMmolL           Decimal?                @map("lactate_mmol_l") @db.Decimal(4, 2)
  crashCartDosagesJson   Json?                   @map("crash_cart_dosages_json")
  assignedShockTable     String?                 @map("assigned_shock_table") @db.VarChar(30)
  assignedRoomId         String?                 @map("assigned_room_id") @db.Uuid
  isCodeRedBroadcasted   Boolean                 @default(false) @map("is_code_red_broadcasted")
  admittedAt             DateTime                @default(now()) @map("admitted_at") @db.Timestamptz
  attendedAt             DateTime?               @map("attended_at") @db.Timestamptz
  stabilizedAt           DateTime?               @map("stabilized_at") @db.Timestamptz
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch                 Branch                  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  patient                Patient?                @relation(fields: [patientId], references: [id], onDelete: SetNull)
  client                 Client?                 @relation(fields: [clientId], references: [id], onDelete: SetNull)
  evaluatedBy            User                    @relation("TriageEvaluator", fields: [evaluatedByUserId], references: [id], onDelete: Restrict)
  attendingVet           User?                   @relation("TriageAttendingVet", fields: [attendingVetId], references: [id], onDelete: SetNull)
  assignedRoom           Room?                   @relation(fields: [assignedRoomId], references: [id], onDelete: SetNull)
  consultations          Consultation[]
  prescriptions          Prescription[]
  surgeries              Surgery[]
  labOrders              LabOrder[]
  imagingStudies         ImagingStudy[]
  hospitalizations       Hospitalization[]
  dteInvoices            DteInvoice[]

  @@index([tenantId, branchId, triageColor, clinicalStatus], name: "idx_emergency_triage_active")
  @@map("emergency_triages")
}

// ============================================================================
// 6. CONSULTAS CLÍNICAS (SOAP AAHA) Y RECETAS
// ============================================================================

model Consultation {
  id                       String               @id @default(uuid()) @db.Uuid
  tenantId                 String               @map("tenant_id") @db.Uuid
  branchId                 String               @map("branch_id") @db.Uuid
  patientId                String               @map("patient_id") @db.Uuid
  veterinarianId           String               @map("veterinarian_id") @db.Uuid
  roomId                   String?              @map("room_id") @db.Uuid
  turnId                   String?              @map("turn_id") @db.Uuid
  emergencyTriageId        String?              @map("emergency_triage_id") @db.Uuid
  consultationType         ConsultationType     @default(GENERAL) @map("consultation_type")
  consultationDate         DateTime             @default(now()) @map("consultation_date") @db.Timestamptz
  anamnesisReason          String               @map("anamnesis_reason") @db.Text
  currentDiet              String?              @map("current_diet") @db.Text
  currentMedications       String?              @map("current_medications") @db.Text
  weightKg                 Decimal              @map("weight_kg") @db.Decimal(6, 3)
  tempCelsius              Decimal?             @map("temp_celsius") @db.Decimal(4, 2)
  heartRateBpm             Int?                 @map("heart_rate_bpm")
  respiratoryRateBpm       Int?                 @map("respiratory_rate_bpm")
  systolicBp               Int?                 @map("systolic_bp")
  capillaryRefillSeconds   Decimal?             @map("capillary_refill_seconds") @db.Decimal(3, 1)
  mucousMembraneStatus     String?              @default("PINK") @map("mucous_membrane_status") @db.VarChar(30)
  hydrationPercentage      Decimal?             @default(0.0) @map("hydration_percentage") @db.Decimal(3, 1)
  bodyConditionScore       Int?                 @map("body_condition_score")
  painScaleScore           Int?                 @map("pain_scale_score")
  physicalExamSystems      Json                 @default("{}") @map("physical_exam_systems")
  subjective               String               @db.Text
  objective                String               @db.Text
  assessmentDiagnosis      String               @map("assessment_diagnosis") @db.Text
  differentialDiagnoses    String[]             @default([]) @map("differential_diagnoses")
  planTherapeuticSummary   String               @map("plan_therapeutic_summary") @db.Text
  requiresHospitalization  Boolean              @default(false) @map("requires_hospitalization")
  requiresSurgery          Boolean              @default(false) @map("requires_surgery")
  requiresLabTests         Boolean              @default(false) @map("requires_lab_tests")
  requiresImaging          Boolean              @default(false) @map("requires_imaging")
  isClosed                 Boolean              @default(false) @map("is_closed")
  closedAt                 DateTime?            @map("closed_at") @db.Timestamptz
  createdAt                DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant                   Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch                   Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  patient                  Patient              @relation(fields: [patientId], references: [id], onDelete: Restrict)
  veterinarian             User                 @relation("VetConsultations", fields: [veterinarianId], references: [id], onDelete: Restrict)
  room                     Room?                @relation(fields: [roomId], references: [id], onDelete: SetNull)
  emergencyTriage          EmergencyTriage?     @relation(fields: [emergencyTriageId], references: [id], onDelete: SetNull)
  addendums                ConsultationAddendum[]
  prescriptions            Prescription[]
  surgeries                Surgery[]
  labOrders                LabOrder[]
  imagingStudies           ImagingStudy[]
  hospitalizations         Hospitalization[]
  dteInvoices              DteInvoice[]

  @@index([tenantId, patientId, consultationDate(sort: Desc)], name: "idx_consultations_patient")
  @@map("consultations")
}

model ConsultationAddendum {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  consultationId String       @map("consultation_id") @db.Uuid
  veterinarianId String       @map("veterinarian_id") @db.Uuid
