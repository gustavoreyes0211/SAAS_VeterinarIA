model Room {
  id                  String                @id @default(uuid()) @db.Uuid
  tenantId            String                @map("tenant_id") @db.Uuid
  branchId            String                @map("branch_id") @db.Uuid
  name                String                @db.VarChar(100)
  code                String                @db.VarChar(20)
  roomType            RoomType              @default(CONSULTATION_GENERAL) @map("room_type")
  status              RoomOperationalStatus @default(AVAILABLE)
  currentDoctorUserId String?               @map("current_doctor_user_id") @db.Uuid
  currentPatientId    String?               @map("current_patient_id") @db.Uuid
  equipmentList       Json                  @default("[]") @map("equipment_list")
  displayOrder        Int                   @default(1) @map("display_order")
  isActive            Boolean               @default(true) @map("is_active")
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant              Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch              Branch                @relation(fields: [branchId], references: [id], onDelete: Cascade)
  currentDoctor       User?                 @relation(fields: [currentDoctorUserId], references: [id], onDelete: SetNull)
  currentPatient      Patient?              @relation(fields: [currentPatientId], references: [id], onDelete: SetNull)
