  isExhausted       Boolean                @default(false) @map("is_exhausted")
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz

  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch            Branch                 @relation(fields: [branchId], references: [id], onDelete: Cascade)
  item              InventoryItem          @relation(fields: [itemId], references: [id], onDelete: Restrict)
  openVials         PharmacyOpenVial[]
  adjustments       InventoryAdjustment[]
  transferItems     InventoryTransferItem[]
  dteInvoiceItems   DteInvoiceItem[]

  @@index([tenantId, branchId, itemId, expirationDate], name: "idx_lots_peps_fifo")
  @@map("inventory_lots")
}

model PharmacyOpenVial {
  id                   String        @id @default(uuid()) @db.Uuid
  tenantId             String        @map("tenant_id") @db.Uuid
  branchId             String        @map("branch_id") @db.Uuid
  itemId               String        @map("item_id") @db.Uuid
  lotId                String        @map("lot_id") @db.Uuid
  openedByUserId       String        @map("opened_by_user_id") @db.Uuid
