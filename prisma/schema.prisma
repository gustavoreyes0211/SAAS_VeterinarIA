model Supplier {
  id             String          @id @default(uuid()) @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  name           String          @db.VarChar(150)
  tradeName      String?         @map("trade_name") @db.VarChar(150)
  nit            String?         @db.VarChar(17)
  nrc            String?         @db.VarChar(20)
  contactName    String?         @map("contact_name") @db.VarChar(100)
  phoneE164      String?         @map("phone_e164") @db.VarChar(20)
  email          String?         @db.VarChar(255)
  address        String?         @db.Text
  creditDays     Int             @default(0) @map("credit_days")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]

  @@index([tenantId], name: "idx_suppliers_tenant")
  @@map("suppliers")
}

model InventoryCategory {
  id               String              @id @default(uuid()) @db.Uuid
  tenantId         String              @map("tenant_id") @db.Uuid
  name             String              @db.VarChar(100)
  code             String?             @db.VarChar(30)
  description      String?             @db.Text
  parentCategoryId String?             @map("parent_category_id") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz

  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parentCategory   InventoryCategory?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id], onDelete: SetNull)
  subCategories    InventoryCategory[] @relation("CategoryHierarchy")
  items            InventoryItem[]

  @@map("inventory_categories")
}

model InventoryItem {
  id                   String               @id @default(uuid()) @db.Uuid
  tenantId             String               @map("tenant_id") @db.Uuid
  categoryId           String?              @map("category_id") @db.Uuid
  sku                  String               @db.VarChar(50)
  barcode              String?              @db.VarChar(100)
  name                 String               @db.VarChar(150)
  genericName          String?              @map("generic_name") @db.VarChar(150)
  unitOfMeasure        String               @default("UNIT") @map("unit_of_measure") @db.VarChar(30)
  isMedication         Boolean              @default(false) @map("is_medication")
  isControlledNarcotic Boolean              @default(false) @map("is_controlled_narcotic")
  isFractionable       Boolean              @default(false) @map("is_fractionable")
  totalVolumePerVialMl Decimal?             @map("total_volume_per_vial_ml") @db.Decimal(10, 3)
  concentrationMgPerMl Decimal?             @map("concentration_mg_per_ml") @db.Decimal(10, 3)
  costPriceAverage     Decimal              @default(0.0000) @map("cost_price_average") @db.Decimal(12, 4)
  salePrice            Decimal              @map("sale_price") @db.Decimal(12, 4)
  taxPercentage        Decimal              @default(13.00) @map("tax_percentage") @db.Decimal(5, 2)
  isActive             Boolean              @default(true) @map("is_active")
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant               Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category             InventoryCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  stocks               InventoryStock[]
  lots                 InventoryLot[]
  openVials            PharmacyOpenVial[]
  poItems              PurchaseOrderItem[]
  adjustments          InventoryAdjustment[]
  transferItems        InventoryTransferItem[]
  dteInvoiceItems      DteInvoiceItem[]

  @@unique([tenantId, sku])
  @@index([tenantId, barcode], name: "idx_inventory_items_barcode")
  @@map("inventory_items")
}

model InventoryStock {
  id                String        @id @default(uuid()) @db.Uuid
  tenantId          String        @map("tenant_id") @db.Uuid
  branchId          String        @map("branch_id") @db.Uuid
  itemId            String        @map("item_id") @db.Uuid
  currentQuantity   Decimal       @default(0.000) @map("current_quantity") @db.Decimal(12, 3)
  minimumAlertStock Decimal       @default(5.000) @map("minimum_alert_stock") @db.Decimal(12, 3)
  reorderQuantity   Decimal       @default(20.000) @map("reorder_quantity") @db.Decimal(12, 3)
  locationBin       String?       @map("location_bin") @db.VarChar(50)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch            Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  item              InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([branchId, itemId])
  @@index([tenantId, branchId], name: "idx_inventory_stocks_branch")
  @@map("inventory_stocks")
}

model InventoryLot {
  id                String                 @id @default(uuid()) @db.Uuid
  tenantId          String                 @map("tenant_id") @db.Uuid
  branchId          String                 @map("branch_id") @db.Uuid
  itemId            String                 @map("item_id") @db.Uuid
