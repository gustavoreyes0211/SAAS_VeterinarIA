# Entorno
NODE_ENV=development
PORT=3000

# Base de Datos PostgreSQL 16 (con soporte RLS)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/veterinaria_db?schema=public"

# Redis 7 (Cache y Colas BullMQ)
REDIS_URL="redis://localhost:6379"

# MinIO / S3 Storage (PACS DICOM, Recetas PDF y Fotos)
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="miniopassword"
S3_BUCKET_NAME="veterinaria-assets"
S3_REGION="us-east-1"

# Seguridad y Autenticación JWT
JWT_SECRET="super-secret-key-change-in-production-min-32-chars-veterinaria"
COOKIE_DOMAIN=".localhost"

# Ministerio de Hacienda de El Salvador (DTE)
# Ambiente: 00 = Sandbox/Pruebas, 01 = Producción
MH_ENVIRONMENT="00"
MH_AUTH_URL="https://admin.factura.gob.sv/prod/auth"
MH_RECEPTION_URL="https://admin.factura.gob.sv/prod/recepciondte"
MH_CONSULTA_URL="https://admin.factura.gob.sv/prod/consultadte"

# WhatsApp Cloud API (Notificaciones y Recordatorios)
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
